# ==============================================================================
# PulseAI - Environment Variables Template (.env.example)
# Copy this file to individual .env files in backend/ and client/ subdirectories
# or configure them at the root level depending on your deployment strategy.
# NEVER commit files containing real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=YOUR_MONGO_URI

# JWT Secret
JWT_SECRET=YOUR_JWT_SECRET

# Google OAuth (for backend ID token verification)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Frontend URI
FRONTEND_URI=http://localhost:5173

# Email Service (Nodemailer / SMTP)
EMAIL=your_email@example.com
PASSWORD=your_email_app_password

# Cloudinary (Media upload storage)
CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
API_KEY=YOUR_CLOUDINARY_API_KEY
API_SECRET=YOUR_CLOUDINARY_API_SECRET

# Twilio (Optional SMS Authentication / Notifications)
# TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
# TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
# TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# Frontend Client Configuration (client/.env)
# ------------------------------------------------------------------------------
VITE_BACKEND_URL=https://pulse-ai-mu1i.onrender.com
VITE_PYTHON_URI=http://127.0.0.1:5001
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
